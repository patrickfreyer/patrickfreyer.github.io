---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ViewSwitcher from '../../components/ViewSwitcher.astro';
import heroLocations from '../../data/heroLocations.yaml';
import flightRoutes from '../../data/flightRoutes.yaml';
---

<BaseLayout
  title="Flight Statistics | Patrick Freyer"
  stylesheets={["/assets/css/flight-stats.css"]}
  fullBleed
>
  <ViewSwitcher current="stats" />

  <script is:inline define:vars={{ heroLocations, flightRoutes }}>
    window.locationsData = heroLocations;
    window.flightRoutesData = flightRoutes;
  </script>

  <div class="stats-page">

      <nav class="stats-nav">
          <a href="/flights/">🌍 Globe</a>
          <a href="/flights/map/">🗺️ Map</a>
          <a href="/flights/network/">🕸️ Network</a>
          <a href="/flights/stats/" class="active">📊 Stats</a>
      </nav>

      <header class="stats-header">
          <h1>Flight Log</h1>
          <p class="stats-range" id="header-range">Loading&hellip;</p>
      </header>

      <!-- 1. Hero KPIs ------------------------------------------------------ -->
      <section class="kpi-row" aria-label="Headline figures">
          <div class="kpi" id="kpi-distance">
              <div class="kpi-label">Distance flown</div>
              <div class="kpi-value">&mdash;</div>
              <div class="kpi-unit">kilometers</div>
              <div class="kpi-spark"></div>
          </div>
          <div class="kpi" id="kpi-flights">
              <div class="kpi-label">Flights</div>
              <div class="kpi-value">&mdash;</div>
              <div class="kpi-unit">legs logged</div>
              <div class="kpi-spark"></div>
          </div>
          <div class="kpi" id="kpi-countries">
              <div class="kpi-label">Countries</div>
              <div class="kpi-value">&mdash;</div>
              <div class="kpi-unit">landed in</div>
              <div class="kpi-spark"></div>
          </div>
          <div class="kpi" id="kpi-years">
              <div class="kpi-label">Years</div>
              <div class="kpi-value">&mdash;</div>
              <div class="kpi-unit">with a flight</div>
              <div class="kpi-spark"></div>
          </div>
      </section>

      <!-- 2. Scale strip ---------------------------------------------------- -->
      <section class="scale-strip" id="scale-strip" aria-label="Distance in context"></section>

      <!-- 3. Cumulative distance -------------------------------------------- -->
      <section class="panel stats-section">
          <div class="panel-head">
              <h2 class="panel-title">Cumulative distance</h2>
              <div class="panel-sub">Every leg, in order flown</div>
          </div>
          <div class="chart" id="chart-cumulative"></div>
      </section>

      <!-- 3b. Per-year magnitude ---------------------------------------------- -->
      <section class="panel stats-section">
          <div class="panel-head">
              <h2 class="panel-title">Distance and legs by year</h2>
              <div class="panel-sub">Bars are kilometers, the line is leg count</div>
          </div>
          <div class="chart" id="chart-years"></div>
      </section>

      <!-- 4. Pairs | cities -------------------------------------------------- -->
      <div class="two-up">
          <section class="panel">
              <div class="panel-head">
                  <h2 class="panel-title">Top city pairs</h2>
                  <div class="panel-sub">Both directions counted</div>
              </div>
              <div class="chart chart--tall" id="chart-pairs"></div>
          </section>
          <section class="panel">
              <div class="panel-head">
                  <h2 class="panel-title">Cities by total distance</h2>
                  <div class="panel-sub">Kilometers flown to or from</div>
              </div>
              <div class="chart chart--tall" id="chart-cities"></div>
          </section>
      </div>

      <!-- 5. Month x year heatmap -------------------------------------------- -->
      <section class="panel stats-section">
          <div class="panel-head">
              <h2 class="panel-title">When the flying happened</h2>
              <div class="panel-sub">Month by year &middot; darker is further</div>
          </div>
          <div class="chart chart--tall" id="chart-heatmap"></div>
      </section>

      <!-- 6. Airlines | occasion --------------------------------------------- -->
      <div class="two-up">
          <section class="panel">
              <div class="panel-head">
                  <h2 class="panel-title">Airline share over time</h2>
                  <div class="panel-sub">Colors match the globe</div>
              </div>
              <div class="chart" id="chart-airlines"></div>
          </section>
          <section class="panel">
              <div class="panel-head">
                  <h2 class="panel-title">Work &middot; Study &middot; Personal</h2>
                  <div class="panel-sub">Why the trip happened</div>
              </div>
              <div class="chart" id="chart-occasion"></div>
          </section>
      </div>

      <!-- 7. Records ---------------------------------------------------------- -->
      <section class="panel stats-section">
          <div class="panel-head">
              <h2 class="panel-title">Records</h2>
              <div class="panel-sub">Extremes of the log</div>
          </div>
          <div id="records"></div>
      </section>

      <!-- 8. Coverage --------------------------------------------------------- -->
      <section class="panel stats-section">
          <div class="panel-head">
              <h2 class="panel-title">Countries &amp; continents</h2>
              <div class="panel-sub">Where the log has been</div>
          </div>
          <div class="chart chart--tall" id="chart-coverage"></div>
      </section>

      <p class="stats-footnote">
          Distances are great-circle between city centers, so they run a little short of
          the real routes. Legs with an unrecorded airline or month still count toward
          every total, but are left out of the rankings.
      </p>

  </div>

  <script is:inline src="/vendor/d3.min.js"></script>
  <script is:inline src="/assets/js/flight-views-common.js"></script>
  <script is:inline src="/assets/js/stats/format.js"></script>
  <script is:inline src="/assets/js/stats/flight-data.js"></script>
  <script is:inline src="/assets/js/stats/flight-metrics.js"></script>
  <script is:inline src="/assets/js/stats/charts/sparkline.js"></script>
  <script is:inline src="/assets/js/stats/charts/cumulative.js"></script>
  <script is:inline src="/assets/js/stats/charts/year-bars.js"></script>
  <script is:inline src="/assets/js/stats/charts/pairs.js"></script>
  <script is:inline src="/assets/js/stats/charts/cities.js"></script>
  <script is:inline src="/assets/js/stats/charts/heatmap.js"></script>
  <script is:inline src="/assets/js/stats/charts/airlines.js"></script>
  <script is:inline src="/assets/js/stats/charts/occasion.js"></script>
  <script is:inline src="/assets/js/stats/charts/coverage.js"></script>
  <script is:inline src="/assets/js/stats/stats-page.js"></script>
</BaseLayout>
